<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <!--        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>-->
        <!--        <UseMauiEssentials>false</UseMauiEssentials>-->
        <!--        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>-->

        <Company>Silverbranch Codeworks</Company>
        <Authors>Tiabeanie Cazier</Authors>
        <Product>$(Company) API Utilities</Product>
        <Title>$(Product) and Extensions</Title>
        <AssemblyName>Utilities.Security</AssemblyName>
        <RootNamespace>Gay.Silverbranch.$(AssemblyName)</RootNamespace>
        <PackageId>Gay.Silverbranch.pkg.$(AssemblyName)</PackageId>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>alpha-$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmmss"))</VersionSuffix>
        <PackageProjectUrl>silverbranch-codeworks.com</PackageProjectUrl>
        <!--    <RepositoryUrl></RepositoryUrl>-->

        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>
        
        <PackageReleaseNotes>
            # Silverbranch Codeworks Security General Extensions Package

            ## Version [1.0.0-alpha] - 2025-07-02

            **Type:** Alpha
            **Stability:** ⚠️ Experimental – Not recommended for production use.

            ---

            ### 🚧 Overview

            This alpha release introduces early implementations of planned features for version 1.0.0.

            > ⚠️ APIs and behavior may change without notice in future builds.

            > 💡 Use this release to explore upcoming features and provide feedback.

            ---

            ### ➕ New Features ➕

            - Briefly list experimental features added
            - e.g. `Added support for async configuration loading via IConfigSource`

            ---

            ### ⚠️ Known Issues / Limitations ️⚠️

            - [ ] So far standardize security extension function only works for backend APIs
            - [ ] Lacks token and claim validations

            ---

            ### 🔗 Related Links 🔗

            - [Full Changelog](CHANGELOG.md#Version-100-alpha)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\Icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>Icon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>README.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\LICENSE.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>LICENSE.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\ReleaseNotes.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>ReleaseNotes.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Gay.Silverbranch.pkg.Utilities.General" Version="1.0.0-alpha-20250731-172824" />
      <PackageReference Include="Keycloak.AuthServices.Authentication" Version="2.6.1" />
      <PackageReference Include="Keycloak.AuthServices.Authorization" Version="2.6.1" />
    </ItemGroup>

</Project>
